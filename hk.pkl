amends "package://github.com/jdx/hk/releases/download/v2.0.1/hk@2.0.1#/Config.pkl"

// The crate lives in gpui/; hook the inputs that change how it builds or lints.
local rust_glob = List(
  "gpui/**/*.rs",
  "gpui/Cargo.toml",
  "gpui/Cargo.lock",
  "rust-toolchain*",
  ".cargo/**",
)

local clippy_cmd =
  "cargo clippy --locked --manifest-path gpui/Cargo.toml --all-targets --all-features"
    + " -- -D warnings -A dead_code"
    + " -A clippy::option_map_unit_fn -A clippy::map_flatten -A clippy::nonminimal_bool"
    + " -A clippy::type_complexity -A clippy::collapsible_if -A clippy::let_and_return"
    + " -A clippy::result_large_err -A clippy::duplicated_attributes -A clippy::useless_conversion"
    + " -A clippy::panic -A clippy::assertions_on_constants"

// Whole-project steps: run on every push and via `hk check --all`. They take no
// file list on purpose — a push must not skip the gate when file matching fails.
local gate = new Mapping<String, Step> {
  ["test"] {
    check = "cargo test --locked --manifest-path gpui/Cargo.toml --all-features"
  }
  ["clippy"] {
    // Same warning baseline as agenda-gpui and the build.yml Windows clippy step.
    check = clippy_cmd
  }
  ["release-rules"] { check = "python scripts/test_release.py" }
}

hooks {
  ["pre-commit"] {
    steps {
      ["cargo-check"] {
        glob = rust_glob
        check = "cargo check --quiet --manifest-path gpui/Cargo.toml"
      }
      ["rustfmt"] {
        glob = List("gpui/**/*.rs")
        check = "cargo fmt --manifest-path gpui/Cargo.toml -- --check"
      }
    }
  }
  ["pre-push"] {
    steps = gate
  }
  ["check"] {
    steps = gate
  }
}
