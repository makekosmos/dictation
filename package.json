{
  "name": "@kosmos/app-dictation",
  "version": "0.2.2",
  "private": true,
  "description": "Dictation — Marketplace extension for Kosmos Desktop.",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "prepare": "lefthook install",
    "validate": "node scripts/validate-manifest.mjs",
    "check:manifest": "bun run validate",
    "typecheck": "vue-tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "package:kspkg": "bun run validate && bun run build && node scripts/package-kspkg.mjs",
    "package:smoke": "node scripts/check-kspkg.mjs",
    "check": "bun run check:manifest && bun run lint && bun run format:check && bun run typecheck && bun run test && bun run package:kspkg && bun run package:smoke"
  },
  "dependencies": {
    "@kosmos/visuals": "npm:@makekosmos/visuals@0.1.2",
    "@lucide/vue": "^1.16.0",
    "@tailwindcss/vite": "^4.2.2",
    "tailwindcss": "^4.1.16",
    "vue": "^3.6.0-beta.12"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.7",
    "bun-types": "^1.3.9",
    "lefthook": "^2.1.10",
    "oxfmt": "0.51.0",
    "oxlint": "1.66.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.3",
    "vitest": "^4.1.6",
    "vue-tsc": "^3.2.6"
  },
  "packageManager": "bun@1.3.14"
}
