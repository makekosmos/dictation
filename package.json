{
  "name": "@kosmos/extension-dictation",
  "version": "0.2.2",
  "private": true,
  "description": "Dictation — Marketplace extension for Kosmos Desktop.",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "build": "vite build",
    "validate": "node scripts/validate-manifest.mjs",
    "package:kspkg": "bun run validate && bun run build && node scripts/package-kext.mjs",
    "package:kext": "bun run package:kspkg",
    "test": "bun run validate"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "tailwindcss": "^4.1.16",
    "vue": "^3.6.0-beta.12"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.7",
    "typescript": "^6.0.3",
    "vite": "^8.0.3"
  }
}
