{
  "name": "@kosmos/app-dictation",
  "version": "0.2.5",
  "private": true,
  "description": "Dictation — Marketplace extension for Kosmos Engine.",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "prepare": "lefthook install",
    "validate": "node scripts/validate-manifest.mjs",
    "check:manifest": "pnpm run validate",
    "typecheck": "vue-tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "build:worker": "node scripts/build-worker.mjs",
    "package:kspkg": "pnpm run validate && pnpm run build && pnpm run build:worker && node scripts/package-kspkg.mjs",
    "package:smoke": "node scripts/check-kspkg.mjs && node scripts/check-worker.mjs",
    "check": "pnpm run check:manifest && pnpm run lint && pnpm run format:check && pnpm run typecheck && pnpm run test && pnpm run package:kspkg && pnpm run package:smoke"
  },
  "dependencies": {
    "@kosmos/visuals": "npm:@makekosmos/visuals@0.1.2",
    "@lucide/vue": "^1.16.0",
    "@tailwindcss/vite": "^4.2.2",
    "tailwindcss": "^4.1.16",
    "vue": "^3.6.0-beta.12"
  },
  "devDependencies": {
    "@types/node": "^24.9.2",
    "@vitejs/plugin-vue": "^6.0.7",
    "@yao-pkg/pkg": "6.22.0",
    "lefthook": "^2.1.10",
    "oxfmt": "0.51.0",
    "oxlint": "1.66.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.3",
    "vitest": "^4.1.6",
    "vue-router": "^5.3.0",
    "vue-tsc": "^3.2.6"
  },
  "packageManager": "pnpm@12.4.1"
}
